# ── LLM (any OpenAI-compatible endpoint) ───────────────────────────────────────
# Default: Groq free tier. Get a key at https://console.groq.com/keys (no card).
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=              # a tool-calling model from Groq's model list (GET /models)
LLM_API_KEY=            # free key from console.groq.com
#
# Google Gemini free tier (https://aistudio.google.com/apikey):
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_MODEL=<a Gemini model with function calling>
#   LLM_API_KEY=<your Gemini key>
#
# Local Ollama (no key; run `ollama pull <model>` first):
#   LLM_BASE_URL=http://host.docker.internal:11434/v1
#   LLM_MODEL=<a local model with tool support>
#   LLM_API_KEY=ollama

# ── Slack (Socket Mode, see README) ───────────────────────────────────────────
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_INCIDENT_CHANNEL=
RERUN_ALLOWED_USERS=    # comma-separated Slack user IDs, e.g. U012ABCDEF,U034GHIJKL

# ── Pulse tracing (optional; tracing is a no-op when PULSE_URL is empty) ──────
PULSE_URL=              # e.g. http://host.docker.internal:8000
PULSE_API_KEY=          # ps_... key from Pulse → Settings → Create project
